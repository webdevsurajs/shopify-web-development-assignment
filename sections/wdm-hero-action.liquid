{% liquid
  assign hero_image = section.settings.background_image
  assign headline_image = section.settings.headline_image
  assign headline_text = section.settings.heading | strip
  assign collection = section.settings.collection
%}

<section class="wdm-hero">
  {% if section.settings.background_image %}
    {{
      section.settings.background_image
      | image_url: width: 2400
      | image_tag:
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        class: 'wdm-hero__image',
        alt: ''
    }}
  {% endif %}

  <div class="wdm-hero__content">
    {% if section.settings.headline_image %}
      {{
        section.settings.headline_image
        | image_url: width: 1200
        | image_tag:
          widths: '400, 600, 800, 1000, 1200',
          sizes: '60vw',
          loading: 'eager',
          alt: section.settings.headline_alt
      }}
    {% else %}
      <h1>{{ section.settings.heading | escape }}</h1>
    {% endif %}

    {% if section.settings.button_label != blank and section.settings.collection != blank %}
      <a href="{{ section.settings.collection.url }}" class="wdm-hero__button">
        {{ section.settings.button_label | escape }}
      </a>
    {% endif %}
  </div>

  {% if section.settings.show_reviews %}
    <div class="wdm-hero__reviews">Reviews</div>
  {% endif %}
</section>

<style>
.wdm-hero {
	position: relative;
	overflow: hidden;
}

.wdm-hero__image {
	display: block;
	width: 100%;
	height: auto;
}

.wdm-hero__content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  max-width: 390px;
  margin: 0 auto;
  gap: 46px;
}

.wdm-hero__content h1,
.wdm-hero__content img {
	width: 100%;
    margin: 0;
    height: auto;	
}

.wdm-hero__button {
    padding: 16px 32px;
    background: #b3fff9;
    color: #011f13;
    text-decoration: none;
    text-transform: uppercase;
    font-size: 16px;
    border: 1px solid #b3fff9;
    font-family: "Inter", sans-serif;
    font-weight: 600;
    letter-spacing: 0;
    max-height: 48px;
    line-height: 100%;
}

.wdm-hero__reviews {
    position: absolute;
    top: 50%;
    right: 0;
    padding: 8px 6px;
    background: #F3F3F3;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    color: #303030;
    font-family: "Inter", sans-serif;
    font-weight: 600;
    letter-spacing: 0;
    font-size: 16px;
    border-radius: 4px;
    max-width: 28px;
    line-height: 100%;
    max-height: 89px;
    box-shadow: 0 1px 4px #0c0c0d0d;
}

</style>

{% schema %}
{
  "name": "Hero Action",
  "tag": "section",
  "class": "section-wdm-hero-action",
  "settings": [
    {
      "type": "header",
      "content": "Hero Action Media"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "headline_image",
      "label": "Headline image",
      "info": "Use the headline lockup here. If left empty, the text headline is used."
    },
    {
      "type": "text",
      "id": "headline_alt",
      "label": "Headline image alt text",
      "default": "Spring Break",
      "info": "Alt text for Headline image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline text",
      "default": "Spring Break",
      "info": "Used when no headline image is selected."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show Reviews tab",
      "default": true
    },
    {
      "type": "text",
      "id": "reviews_tab_text",
      "label": "Reviews tab Text",
      "default": "Reviews"
    }
  ],
  "presets": [
    {
      "name": "Hero Action",
      "category": "Custom"
    }
  ]
}
{% endschema %}