{% liquid
  assign selected_collection = section.settings.collection
%}

<div class="wdm-product-grid-section">
  {% if section.settings.heading != blank %}
    <h2 class="wdm-product-grid-section__heading">
      {{ section.settings.heading | escape }}
    </h2>
  {% endif %}

  {% if selected_collection != blank %}
    {% paginate selected_collection.products by section.settings.products_to_show %}
      <div class="wdm-product-grid" data-wdm-product-grid>
        {% for product in selected_collection.products %}
          {% render 'wdm-product-card', product: product, 
            show_vendor: section.settings.show_vendor,
            show_badge: section.settings.show_badge,
            show_secondary_text: section.settings.show_secondary_text %}
        {% else %}
          <p class="wdm-product-grid__empty">No products found.</p>
        {% endfor %}
      </div>
    {% endpaginate %}
  {% else %}
    <div class="wdm-product-grid__empty">
      Select a collection to display products.
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product Grid",
  "tag": "section",
  "class": "section-wdm-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 1
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_secondary_text",
      "label": "Show Secondary Text",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}
